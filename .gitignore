# Build artifacts: the whole extension/ tree is generated by `npm run build`
# (build.sh rm -rf's and regenerates it from extension-src/). Source of truth is
# extension-src/. Do not commit generated output.
/extension/
# Packed release zips produced by `npm run pack` / the Release workflow.
/dist/
node_modules
.dev/
.idea/
# throwaway feature-debug UI test scripts (copies of tests/ui/feature-debug.stub.sh)
tests/ui/local-*
# Per-task working files live in docs/requests/<task-name>/ and are excluded
# locally via .git/info/exclude (see AGENTS.md, "Documentation: LLM wiki").
